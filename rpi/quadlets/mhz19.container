[Unit]
Description=MH-Z19 CO2 sensor measurement
After=mosquitto.service

[Container]
Image=localhost/airq-sensor:latest
EnvironmentFile=%h/.airq/config.env
Environment=SENSOR_TYPE=mhz19
Environment=MQTT_TOPIC=sensors/mhz19
Environment=MHZ19_PORT=/dev/ttyS0
AddDevice=/dev/ttyS0
Network=airq.network

[Service]
Type=oneshot
RemainAfterExit=no
