TZ=Europe/Berlin

MQTT_HOST=mosquitto
MQTT_PORT=1883

OWM_API_KEY=your_api_key_here
LATITUDE=52.5200
LONGITUDE=13.4050

# Pi's IP or hostname (used by server/telegraf to connect to the MQTT broker)
MQTT_BROKER=100.x.x.x

GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme

# SDS011 tuning (optional, defaults shown)
# SDS011_PORT=/dev/ttyUSB0
# WARM_UP_TIME=15
# COLLECT_TIME=15
